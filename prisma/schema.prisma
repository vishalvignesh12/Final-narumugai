generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  INITIATION_PENDING
  PENDING
  UNKNOWN
  SUCCEEDED
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum InventoryMovementKind {
  ADJUSTMENT
  RESERVED
  RELEASED
  SOLD
  RESTOCKED
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  phone           String      @unique @db.VarChar(16)
  email           String?     @unique @db.VarChar(320)
  displayName     String      @db.VarChar(120)
  role            UserRole    @default(CUSTOMER)
  status          UserStatus  @default(ACTIVE)
  phoneVerifiedAt DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  sessions        Session[]
  addresses       Address[]
  cart            Cart?
  wishlist        Wishlist?
  orders          Order[]
  couponRedemptions CouponRedemption[]
  inventoryMovements InventoryMovement[]
  adminAudits     AdminAudit[]

  @@index([role, status])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime? @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  recipientName String   @db.VarChar(120)
  phone         String   @db.VarChar(16)
  line1         String   @db.VarChar(240)
  line2         String?  @db.VarChar(240)
  landmark      String?  @db.VarChar(120)
  city          String   @db.VarChar(120)
  state         String   @db.VarChar(120)
  postalCode    String   @db.Char(6)
  countryCode   String   @default("IN") @db.Char(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([userId], where: { isDefault: true }, map: "addresses_one_default_per_user_key")
  @@map("addresses")
}

model Category {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(120)
  slug      String        @unique @db.VarChar(160)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  products  Product[]

  @@index([status, name])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  slug        String        @unique @db.VarChar(180)
  name        String        @db.VarChar(240)
  description String        @db.Text
  status      CatalogStatus @default(DRAFT)
  featured    Boolean       @default(false)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  optionTypes OptionType[]
  variants    ProductVariant[]
  wishlistItems WishlistItem[]

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@index([featured, status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.VarChar(2048)
  assetId   String?  @db.VarChar(255)
  alt       String   @default("") @db.VarChar(240)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model OptionType {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @db.Uuid
  name      String        @db.VarChar(80)
  position  Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    OptionValue[]

  @@unique([productId, name])
  @@index([productId, position])
  @@map("option_types")
}

model OptionValue {
  id           String             @id @default(uuid()) @db.Uuid
  optionTypeId String             @db.Uuid
  value        String             @db.VarChar(120)
  normalized   String             @db.VarChar(120)
  optionType   OptionType         @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  variantLinks VariantOptionValue[]

  @@unique([optionTypeId, normalized])
  @@map("option_values")
}

model ProductVariant {
  id              String              @id @default(uuid()) @db.Uuid
  productId       String              @db.Uuid
  sku             String              @unique @db.VarChar(80)
  optionKey       String              @db.VarChar(512)
  pricePaise      Int
  compareAtPaise  Int?
  status          CatalogStatus       @default(ACTIVE)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  optionValues    VariantOptionValue[]
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reservationItems ReservationItem[]

  @@unique([productId, optionKey])
  @@index([productId, status])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId    String        @db.Uuid
  optionValueId String       @db.Uuid
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue  OptionValue   @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId, variantId])
  @@map("variant_option_values")
}

model Inventory {
  id        String      @id @default(uuid()) @db.Uuid
  variantId String      @unique @db.Uuid
  onHand    Int         @default(0)
  reserved  Int         @default(0)
  version   Int         @default(0)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations ReservationItem[]
  movements InventoryMovement[]

  @@map("inventory")
}

model Cart {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String?    @unique @db.Uuid
  guestTokenHash String?   @unique @db.Char(64)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @unique @db.Uuid
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@map("wishlist_items")
}

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique @db.VarChar(64)
  discountKind     String             @db.VarChar(16)
  discountValue    Int
  minimumSpendPaise Int               @default(0)
  maximumDiscountPaise Int?
  globalLimit      Int?
  perUserLimit     Int?
  startsAt         DateTime?          @db.Timestamptz(3)
  expiresAt        DateTime?          @db.Timestamptz(3)
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  redemptions      CouponRedemption[]
  orders           Order[]

  @@index([active, startsAt, expiresAt])
  @@map("coupons")
}

model Order {
  id                String                @id @default(uuid()) @db.Uuid
  orderNumber       String                @unique @db.VarChar(40)
  userId            String?               @db.Uuid
  couponId          String?               @db.Uuid
  idempotencyKey    String                @db.VarChar(128)
  idempotencyScope  String                @db.VarChar(128)
  guestTokenHash    String?               @db.Char(64)
  currency          String                @default("INR") @db.Char(3)
  subtotalPaise     Int
  discountPaise     Int                   @default(0)
  shippingPaise     Int                   @default(0)
  taxPaise          Int                   @default(0)
  totalPaise        Int
  status            OrderStatus           @default(PENDING_PAYMENT)
  contactName       String                @db.VarChar(120)
  contactPhone      String                @db.VarChar(16)
  contactEmail      String?               @db.VarChar(320)
  addressSnapshot   Json
  cancellationReason String?              @db.VarChar(500)
  cancellationApprovedBy String?           @db.Uuid
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payments          Payment[]
  reservation       InventoryReservation?
  couponRedemption  CouponRedemption?
  coupon             Coupon?               @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([idempotencyScope, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @db.Uuid
  variantId        String?        @db.Uuid
  productName      String         @db.VarChar(240)
  sku              String         @db.VarChar(80)
  optionSnapshot   Json
  quantity         Int
  unitPricePaise   Int
  discountPaise    Int            @default(0)
  taxPaise         Int            @default(0)
  lineTotalPaise   Int
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @db.Uuid
  provider              String        @default("PAYU") @db.VarChar(24)
  providerTransactionId String?       @unique @db.VarChar(128)
  amountPaise           Int
  currency              String        @default("INR") @db.Char(3)
  status                PaymentStatus @default(INITIATION_PENDING)
  idempotencyKey        String        @unique @db.VarChar(128)
  providerReference     String?       @db.VarChar(128)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  confirmedAt           DateTime?     @db.Timestamptz(3)
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events                PaymentEvent[]

  @@index([orderId, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id             String   @id @default(uuid()) @db.Uuid
  paymentId      String   @db.Uuid
  dedupeKey      String   @unique @db.VarChar(160)
  verified       Boolean
  payloadDigest  String?  @db.Char(64)
  receivedAt     DateTime @default(now()) @db.Timestamptz(3)
  processedAt    DateTime? @db.Timestamptz(3)
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, receivedAt])
  @@map("payment_events")
}

model InventoryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @unique @db.Uuid
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime          @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  releasedAt  DateTime?         @db.Timestamptz(3)
  consumedAt  DateTime?         @db.Timestamptz(3)
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items       ReservationItem[]

  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model ReservationItem {
  reservationId String              @db.Uuid
  inventoryId   String              @db.Uuid
  variantId     String              @db.Uuid
  quantity      Int
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  inventory     Inventory           @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  variant       ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([reservationId, inventoryId])
  @@map("reservation_items")
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @db.Uuid
  userId     String?  @db.Uuid
  orderId    String   @unique @db.Uuid
  redeemedAt DateTime @default(now()) @db.Timestamptz(3)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model InventoryMovement {
  id          String               @id @default(uuid()) @db.Uuid
  inventoryId String               @db.Uuid
  actorUserId String?              @db.Uuid
  kind        InventoryMovementKind
  quantityDelta Int
  reference   String?              @db.VarChar(160)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  inventory  Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  actor       User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@map("inventory_movements")
}

model AdminAudit {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(80)
  entityId    String   @db.VarChar(80)
  details     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("admin_audits")
}
