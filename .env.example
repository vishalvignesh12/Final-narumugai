# Legacy storefront
MONGODB_URI="mongodb://127.0.0.1:27017/narumugai_dev"
SECRET_KEY="replace-with-a-long-random-local-secret"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SMTP for email OTP sign-in, email verification, and transactional mail
NODEMAILER_HOST="smtp.example.com"
NODEMAILER_PORT="587"
NODEMAILER_SECURE="false"
NODEMAILER_EMAIL=""
NODEMAILER_PASSWORD=""
ADMIN_ORDER_EMAIL=""

# Cloudinary media uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_SECRET_KEY=""

# Supabase PostgreSQL
# The PostgreSQL V2 API is disabled unless this is explicitly enabled after cutover.
ENABLE_V2_API="false"
# Runtime: use the Supavisor session pooler (port 5432) for the current long-running Next.js server.
# If the deployment runs serverless, use the transaction pooler (port 6543) and add pgbouncer=true.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres"

# Prisma migrations: use Supabase's direct connection when the environment supports IPv6,
# otherwise use the Supavisor session pooler (port 5432). Never use transaction mode for migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Optional development-only fixture; this never creates an admin or a verified account.
DEV_SEED_CUSTOMER_PHONE=""
DEV_SEED_CUSTOMER_NAME="Development Customer"

# V2 PayU checkout. The status endpoint defaults from PAYU_ENDPOINT; override only if PayU requires a different URL.
PAYU_KEY=""
PAYU_SALT=""
PAYU_ENDPOINT="https://test.payu.in/_payment"
PAYU_STATUS_ENDPOINT=""

# Configure a scheduler to POST the reservation expiry route every few minutes.
RESERVATION_EXPIRY_SECRET="replace-with-a-long-random-secret"
